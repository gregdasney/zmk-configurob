#!/usr/bin/env python3
"""serialtap - capture the full raw USB debug stream from the Corne left half.

Opens the left/central half's USB logging tty in raw mode and appends every line,
timestamped, to a log file. Records ALL Zephyr events, not just battery, so a
separate scraper can pull whatever data is needed later.

Usage:
  serialtap [tty] [interval]
    tty       serial device of the left half (default: auto-detected)
    interval  how often to flush the log file, seconds (default: 10)
  env CAPTURE  log file path (default: tmp/serial.log)
"""

import os
import re
import select
import subprocess
import sys
import termios
import time
from datetime import datetime

INTERVAL = int(sys.argv[2]) if len(sys.argv) > 2 else 10
INTERVAL = max(1, INTERVAL)
CAPTURE = os.environ.get("CAPTURE", os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "tmp", "serial.log"))

# Only persist lines relevant to battery monitoring; the rest of the debug
# stream (keycodes, layers, etc.) is discarded so nothing sensitive hits disk.
BATTERY_RE = re.compile(r"vddh_sample_fetch|BATTERY|battery level event",
                        re.IGNORECASE)

STATE_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "tmp", "last-tty")


def find_left_serial():
    import glob
    map_file = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".flash-map")
    try:
        with open(map_file) as fh:
            for line in fh:
                parts = line.split()
                if len(parts) == 2 and parts[1] == "left":
                    return parts[0]
    except FileNotFoundError:
        pass
    return None


def tty_serials():
    import glob
    out = subprocess.run(
        ["ioreg", "-r", "-l", "-w0", "-c", "IOUSBHostDevice"],
        capture_output=True, text=True).stdout
    dev_serial = {}
    cur = None
    for line in out.splitlines():
        m = re.search(r"@([0-9A-Fa-f]{8})\s+<class IOUSBHostDevice", line)
        if m:
            cur = m.group(1).upper()
            continue
        m = re.search(r'"USB Serial Number" = "([^"]+)"', line)
        if m and cur:
            dev_serial.setdefault(cur, m.group(1))
    result = {}
    for t in glob.glob("/dev/cu.usbmodem*"):
        m = re.search(r"usbmodem(\d+)", t)
        if not m:
            continue
        addr = "00" + m.group(1)[:6]
        result[t] = dev_serial.get(addr)
    return result


def find_tty():
    import glob
    # Prefer the last-known-good tty if it still exists.
    try:
        with open(STATE_FILE) as fh:
            last = fh.read().strip()
        if last and os.path.exists(last):
            return last
    except FileNotFoundError:
        pass

    left_serial = find_left_serial()
    candidates = []
    for t, serial in tty_serials().items():
        if left_serial and serial == left_serial:
            candidates.append(t)
    if not candidates:
        candidates = list(glob.glob("/dev/cu.usbmodem*"))
    if not candidates:
        return None
    best = candidates[0]
    for t in candidates:
        try:
            fd = os.open(t, os.O_RDWR | os.O_NOCTTY)
        except OSError:
            continue
        try:
            attrs = termios.tcgetattr(fd)
            attrs[0] = 0
            attrs[1] = 0
            attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
            attrs[3] = 0
            termios.tcsetattr(fd, termios.TCSANOW, attrs)
            end = time.time() + 3
            buf = b""
            while time.time() < end:
                r, _, _ = select.select([fd], [], [], 0.2)
                if fd in r:
                    try:
                        chunk = os.read(fd, 4096)
                        if chunk:
                            buf += chunk
                    except BlockingIOError:
                        pass
            if b"BATTERY" in buf or b"split_central" in buf or b"zmk:" in buf:
                best = t
                break
        finally:
            os.close(fd)
    return best


def main():
    tty = sys.argv[1] if len(sys.argv) > 1 else ""
    if not tty:
        tty = find_tty()
    if not tty:
        print("error: no left-half USB logging tty found. Is it plugged in?", file=sys.stderr)
        return 1

    os.makedirs(os.path.dirname(CAPTURE), exist_ok=True)
    try:
        with open(STATE_FILE, "w") as fh:
            fh.write(tty)
    except OSError:
        pass

    fd = os.open(tty, os.O_RDWR | os.O_NOCTTY)
    attrs = termios.tcgetattr(fd)
    attrs[0] = 0
    attrs[1] = 0
    attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
    attrs[3] = 0
    termios.tcsetattr(fd, termios.TCSANOW, attrs)

    print(f"tapping {tty} -> {CAPTURE} (flush every {INTERVAL}s; Ctrl-C to stop)", flush=True)

    buf = b""
    last_flush = time.time()
    try:
        with open(CAPTURE, "a") as fh:
            while True:
                r, _, _ = select.select([fd], [], [], 0.25)
                if fd in r:
                    try:
                        chunk = os.read(fd, 4096)
                    except BlockingIOError:
                        chunk = b""
                    if chunk:
                        buf += chunk
                        while b"\n" in buf:
                            raw, buf = buf.split(b"\n", 1)
                            try:
                                line = raw.decode("utf-8", "replace")
                            except Exception:
                                continue
                            stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                            if not BATTERY_RE.search(line):
                                continue
                            print(f"{stamp} {line}", flush=True)
                            fh.write(f"{stamp} {line}\n")
                now = time.time()
                if now - last_flush >= INTERVAL:
                    last_flush = now
                    fh.flush()
    except KeyboardInterrupt:
        print("stopping", flush=True)
        return 0
    finally:
        os.close(fd)


if __name__ == "__main__":
    sys.exit(main())
