// corne.keymap - Personal layout using urob's infrastructure

// Key position macros for combos (42-key layout)
#include "zmk-helpers/key-labels/42.h"

// NOTE: ZMK Studio requires a physical layout with `keys` property for visualization.
// The Corne's physical layout is defined in zmk/app/boards/shields/corne/corne.dtsi
// as `foostan_corne_6col_layout` with full `keys` property (key positions, sizes, etc.)
// The chosen node in that file sets: zmk,physical-layout = &foostan_corne_6col_layout;

// Intercept urob's ZMK_BASE_LAYER - define as no-op BEFORE including base.keymap
#define ZMK_BASE_LAYER(name, ...)

// Include urob's base.keymap (HRMs, combos, shortcuts, etc.)
#include "base.keymap"

// Personal layer macro - same signature as urob's ZMK_BASE_LAYER
#define PERSONAL_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH) \
    ZMK_LAYER(name, LT RT LM RM LB RB LH RH)

// ------ Personal Layers ------

PERSONAL_LAYER(base,
    
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
       ___           &kp Q          &kp W         &kp E         &kp R         &kp T     ,   &kp Y         &kp U         &kp I         &kp O         &kp P           ___           ,
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       ___         &hml LGUI A   &hml LALT S   &hml LSHFT D  &hml LCTRL F     &kp G     ,   &kp H       &hmr LCTRL J   &hmr RSHFT K  &hmr LALT L   &hmr LGUI semicolon      ___         ,
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       ___            &kp Z         &kp X         &kp C         &kp V         &kp B     ,   &kp N         &kp M        &comma_morph  &dot_morph    &qexcl           ___           ,
// ╰─────────────┼─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                                &lt FN RET  &lt_spc NAV 0 &kp BSPC      ,   ___               ___        ___
//                                           ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯


)

PERSONAL_LAYER(nav,
    &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 , &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 ,
    NAV_LEFT NAV_UP NAV_DOWN NAV_RIGHT &kp GRAVE , &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp DEL ,
    &kp TAB &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) , &kp PGUP &kp PGDN &kp HOME &kp END &kp BSPC ,
    &lt FN RET &lt_spc NAV 0 , &kp SPACE SMART_NUM &smart_mouse
)

PERSONAL_LAYER(num,
    &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 , &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 ,
    &kp TAB &kp N1 &kp N2 &kp N3 &kp N4 , &kp N5 &kp N6 &kp N7 &kp N8 &kp N0 ,
    &kp LS(L) &kp S &kp D &kp F &kp G , &kp H &kp J &kp K &kp L &kp SQT ,
    &kp LGUI &kp LSHFT , &smart_mouse
)




