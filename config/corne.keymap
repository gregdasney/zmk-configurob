//BLUE
PERSONAL_LAYER(Blue,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        &kp B     &bt BT_CLR          XXX         XXX         XXX           XXX         ,     XXX           XXX          XXX              XXX         XXX       &studio_unlock             ,
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
         XXX           XXX       &bt BT_SEL 3     XXX           XXX       &bootloader  ,  &bootloader       XXX           XXX           XXX            XXX           XXX             ,
